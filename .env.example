# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are embedded in the app bundle: only public/free keys.

# YouTube via your own SONIQ server (server/ folder). Personal use only.
# REQUIRED for the desktop (Tauri) build — browsers block custom User-Agent headers
# on audio elements, so the server proxies the audio stream.
# Run locally: cd server && npm install && node index.js
EXPO_PUBLIC_SONIQ_SERVER_URL=
EXPO_PUBLIC_SONIQ_SERVER_KEY=

# Jam (listen together): free Supabase project -> Settings -> API. Anon key is public.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI (Groq) recommendations: free key from console.groq.com
# NOTE: EXPO_PUBLIC_ values are embedded in the bundle — this ships in the app.
# For production prefer a server-side proxy (Supabase Edge Function) instead.
EXPO_PUBLIC_GROQ_API_KEY=
