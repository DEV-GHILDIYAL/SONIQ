# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are embedded in the app bundle: only public/free keys.
# YouTube via your own SONIQ server (server/ folder). Personal use only.
EXPO_PUBLIC_SONIQ_SERVER_URL=
EXPO_PUBLIC_SONIQ_SERVER_KEY=

# Jam (listen together): free Supabase project -> Settings -> API. Anon key is public.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI (Groq) runs through the `ai` Supabase Edge Function: set GROQ_API_KEY there with
#   npx supabase secrets set GROQ_API_KEY=gsk_...
# Never put the Groq key in this file (EXPO_PUBLIC_ values ship inside the APK).
