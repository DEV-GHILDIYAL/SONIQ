{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SONIQ",
  "version": "0.0.0",
  "identifier": "com.devghildiyal.soniq.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SONIQ",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#121110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DEV-GHILDIYAL",
    "shortDescription": "SONIQ music player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
